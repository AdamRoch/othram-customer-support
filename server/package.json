{
  "name": "@othram/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "smoke:vendors": "tsx scripts/vendor-smoke.ts",
    "typecheck:smoke": "tsc --noEmit -p tsconfig.smoke.json",
    "test": "vitest run --fileParallelism=false"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.64.0",
    "@fastify/cors": "^10.0.1",
    "@othram/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "openai": "^7.5.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
